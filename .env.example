# Google Gemini AI
GOOGLE_API_KEY=your_gemini_api_key_here

# Bright Data Web Scraping
BRIGHT_DATA_SCRAPING_BROWSER_URL=wss://your_bright_data_scraping_browser_endpoint
BRIGHT_DATA_WEB_UNLOCKER_URL=http://your_bright_data_web_unlocker_proxy:port
BRIGHT_DATA_API_TOKEN=your_bright_data_token_here

# OpenRouteService Routing & Distance Matrix
OPEN_ROUTE_API_KEY=your_openrouteservice_api_key_here

# Bhashini Indic Language Services (Optional - WebSpeech fallback included)
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here

# Twilio WhatsApp Sandbox (Transporter Dispatch)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Supabase (Optional - SQLite embedded fallback included)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Configuration
DATABASE_URL=sqlite:///./kisan_arbitrage.db
PORT=8000
ENVIRONMENT=development
